{
  "tools": [
    {
      "name": "jumpPage",
      "description": "Navigate the user to an in-app page.",
      "parameters": {
        "type": "object",
        "properties": {
          "page": { "type": "string" }
        },
        "required": ["page"]
      },
      "requires_approval": false,
      "roles": ["role-admin", "role-sales"]
    },
    {
      "name": "openTicket",
      "description": "Open a support ticket for the user.",
      "parameters": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" }
        },
        "required": ["subject"]
      },
      "requires_approval": true,
      "roles": ["role-support"]
    }
  ]
}
