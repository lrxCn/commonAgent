# --- Agent (内网 Gateway，须先启动) ---
AGENT_URL=http://127.0.0.1:18080
# 转发 Agent 时可选；Agent 第一期不校验，后期内网鉴权用
# INTERNAL_API_KEY=***

# --- Back HTTP ---
BACK_HOST=0.0.0.0
BACK_PORT=8080
# HttpOnly Cookie Session 签名密钥（生产必改）
SESSION_SECRET=change-me-in-production
# 允许携带 Cookie 的前端 Origin（Vue dev server 默认 5173）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# --- Back 业务库（与 Agent 同 Postgres 实例、不同 database）---
# 推荐：复用 agent/.env 的 DATABASE_URL，Back 自动换库名 common_agent_back
AGENT_DATABASE_URL=postgresql://postgres:***@localhost:5432/common_agent
# 或直接写完整 Back 库 URL（与 Agent 同 host/user/password）
# DATABASE_URL=postgresql+psycopg://postgres:***@localhost:5432/common_agent_back
BACK_DATABASE_NAME=common_agent_back
# 种子 admin 用户默认密码（仅演示；生产必改）
ADMIN_SEED_PASSWORD=123456

# --- 演示用户（第一期无 JWT；真实鉴权在 Back）---
DEMO_USER_ID=demo
DEMO_ROLE_ID=demo
DEMO_TOOLS_FILE=config/tools.demo.json

# --- 转发超时（秒）---
AGENT_TIMEOUT_SECONDS=120

# --- 火山引擎流式语音识别 SAUC（见 docs/prd/volcengine-streaming-asr.md）---
# 文档: https://www.volcengine.com/docs/6561/1354869?lang=zh （新版本控制台鉴权）
# 新版本控制台 API Key → 请求头 X-Api-Key（勿提交 git）
VOLC_ASR_ACCESS_KEY=***
# 已废弃：旧版 X-Api-App-Key，新控制台不再使用
# VOLC_ASR_APP_KEY=***
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# ASR 2.0（Seed）默认；豆包流式 ASR 1.0 账号改为 volc.bigasr.sauc.duration
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 上游 PCM 分包时长（毫秒），双向流式推荐 200
VOLC_ASR_SEGMENT_MS=200

# --- OpenAI-compatible STT fallback（未配置 VOLC_ASR_ACCESS_KEY 时使用；兼容 lcjs 的 SiliconFlow 转写）---
STT_OPENAI_COMPAT_BASE_URL=https://api.siliconflow.cn/v1
# 可直接复用 lcjs 的 SILICONFLOW_API_KEY；三者优先级：STT_API_KEY > SILICONFLOW_STT_API_KEY > SILICONFLOW_API_KEY
STT_API_KEY=
SILICONFLOW_STT_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_TIMEOUT_SECONDS=60

# --- 科大讯飞流式语音听写（优先于 SiliconFlow fallback；密钥只放 Back，禁止 VITE_*）---
XUNFEI_ASR_APP_ID=
XUNFEI_ASR_API_KEY=
XUNFEI_ASR_API_SECRET=
XUNFEI_ASR_WS_URL=wss://iat-api.xfyun.cn/v2/iat

# --- 通话转写落库：敏感词检索 ---
# 逗号分隔；Back 在挂断 transcript 入库时做确定性关键词命中，结果供 Agent 查询。
CALL_TRANSCRIPT_SENSITIVE_WORDS=退款,投诉,违约,敏感,辱骂,威胁,诈骗,转账,银行卡,身份证
