# --- Agent (内网 Gateway，须先启动) ---
AGENT_URL=http://127.0.0.1:18080
# 转发 Agent 时可选；Agent 第一期不校验，后期内网鉴权用
# INTERNAL_API_KEY=***

# --- Back HTTP ---
BACK_HOST=0.0.0.0
BACK_PORT=8080

# --- Back 业务库（与 Agent 同 Postgres 实例、不同 database）---
DATABASE_URL=postgresql+psycopg://postgres:***@localhost:5432/common_agent_back
# 种子 admin 用户默认密码（仅演示；生产必改）
ADMIN_SEED_PASSWORD=123456

# --- 演示用户（第一期无 JWT；真实鉴权在 Back）---
DEMO_USER_ID=demo
DEMO_ROLE_ID=demo
DEMO_TOOLS_FILE=config/tools.demo.json

# --- 转发超时（秒）---
AGENT_TIMEOUT_SECONDS=120
