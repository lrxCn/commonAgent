# --- Agent (内网 Gateway，须先启动) ---
AGENT_URL=http://127.0.0.1:18080
# 转发 Agent 时可选；Agent 第一期不校验，后期内网鉴权用
# INTERNAL_API_KEY=***

# --- Back HTTP ---
BACK_HOST=0.0.0.0
BACK_PORT=8080
# HttpOnly Cookie Session 签名密钥（生产必改）
SESSION_SECRET=change-me-in-production
# 允许携带 Cookie 的前端 Origin（Vue dev server 默认 5173）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000

# --- Back 业务库（与 Agent 同 Postgres 实例、不同 database）---
# 推荐：复用 agent/.env 的 DATABASE_URL，Back 自动换库名 common_agent_back
AGENT_DATABASE_URL=postgresql://postgres:***@localhost:5432/common_agent
# 或直接写完整 Back 库 URL（与 Agent 同 host/user/password）
# DATABASE_URL=postgresql+psycopg://postgres:***@localhost:5432/common_agent_back
BACK_DATABASE_NAME=common_agent_back
# 种子 admin 用户默认密码（仅演示；生产必改）
ADMIN_SEED_PASSWORD=123456

# --- 演示用户（第一期无 JWT；真实鉴权在 Back）---
DEMO_USER_ID=demo
DEMO_ROLE_ID=demo
DEMO_TOOLS_FILE=config/tools.demo.json

# --- 转发超时（秒）---
AGENT_TIMEOUT_SECONDS=120
