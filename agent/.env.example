# --- LangSmith ---
LANGSMITH_API_KEY=lsv2_***
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=common-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# Optional: max chars for message fields in trace metadata (default 500)
# LANGCHAIN_TRACE_MESSAGE_MAX_CHARS=500

# --- LLM：SiliconFlow（OpenAI 兼容）---
OPENAI_API_KEY=sk-***
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=Pro/moonshotai/Kimi-K2.6
# 小任务模型：低延迟 query rewrite；未设置时 fallback 到 OPENAI_MODEL_NAME
REWRITE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
REWRITE_MAX_TOKENS=64
REWRITE_TIMEOUT_SECONDS=15
# 寒暄/自包含问句跳过改写 LLM（降延迟）；false 恢复每轮 LLM 改写
REWRITE_SKIP_ENABLED=true
# REWRITE_MIN_SELF_CONTAINED_LEN=8
# 调试：true 时强制每轮调用改写 LLM
# REWRITE_FORCE=false

# --- RAG 路由（rules=仅规则；hybrid=规则不确定时小模型分类）---
RAG_ROUTER_MODE=hybrid
RAG_ROUTER_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
RAG_ROUTER_MAX_TOKENS=32
RAG_ROUTER_TIMEOUT_SECONDS=5

# --- Embedding（SiliconFlow 同平台或 OpenAI 兼容 embedding 接口）---
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_DIMS=1024

# --- Rerank ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=10

# --- KB Ingest（分块约 512–1024 token，overlap 10–15%）---
# CHUNK_SIZE_TOKENS=768
# CHUNK_OVERLAP_RATIO=0.12

# --- RagSubAgent 二查（主检索空或最高分低于阈值时触发；仅二查，无第三次）---
# RAG_SUBAGENT_SCORE_THRESHOLD=0.3
# RAG_SUBAGENT_TOP_K=20
# RAG_CHUNKS_MAX=10

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_KB=common_agent_kb
# 无本地 Qdrant 时保持 true；检索返回 fixture，不连库
QDRANT_MOCK=false

# --- mem0（本地 OSS + Qdrant；勿配置 MEM0_API_KEY）---
MEM0_MOCK=false
QDRANT_COLLECTION_MEM0=common_agent_mem0
MEM0_READ_LIMIT=50

# --- Postgres Checkpointer
DATABASE_URL=postgresql://postgres:***@localhost:5432/common_agent


AGENT_HOST=0.0.0.0
AGENT_PORT=18080


GUARDRAILS_ENABLED=true
