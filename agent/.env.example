# --- LangSmith ---
# LangSmith API key；LANGCHAIN_API_KEY 未配置时会自动 fallback 到这个值。
LANGSMITH_API_KEY=lsv2_***
# 是否开启 LangSmith / LangChain tracing。
LANGCHAIN_TRACING_V2=true
# LangSmith 项目名。
LANGCHAIN_PROJECT=common-agent
# LangSmith API endpoint。
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# 可选独立 LangChain API key；不填则使用 LANGSMITH_API_KEY。
LANGCHAIN_API_KEY=
# trace metadata 中消息预览的最大字符数，避免 trace 过长。
LANGCHAIN_TRACE_MESSAGE_MAX_CHARS=500

# --- LLM Provider：SiliconFlow（OpenAI 兼容）---
# OpenAI-compatible LLM API key。
OPENAI_API_KEY=sk-***
# OpenAI-compatible base URL。
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# 默认主模型；Supervisor/deepagents 默认使用它。
OPENAI_MODEL_NAME=Pro/moonshotai/Kimi-K2.6

# --- Query Rewrite ---
# rewrite 专用小模型；留空时 fallback 到 OPENAI_MODEL_NAME。
REWRITE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# rewrite 最大输出 token。
REWRITE_MAX_TOKENS=64
# rewrite 调用超时秒数。
REWRITE_TIMEOUT_SECONDS=15
# true 时寒暄/自包含问句/事实陈述可跳过 rewrite LLM。
REWRITE_SKIP_ENABLED=true
# 自包含问题跳过 rewrite 的最小长度。
REWRITE_MIN_SELF_CONTAINED_LEN=8
# 调试开关：true 时强制调用 rewrite LLM。
REWRITE_FORCE=false

# --- Chitchat Lightweight Executor ---
# false：chitchat 走模板；true：chitchat 走低延迟小模型。
CHITCHAT_USE_LLM=false
# chitchat 专用小模型；留空时 fallback 到 OPENAI_MODEL_NAME。
CHITCHAT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# chitchat 小模型最大输出 token。
CHITCHAT_MAX_TOKENS=48
# chitchat 小模型调用超时秒数。
CHITCHAT_TIMEOUT_SECONDS=5

# --- RAG 路由（rules=仅规则；hybrid=规则不确定时小模型分类）---
# RAG router 模式：rules 或 hybrid。
RAG_ROUTER_MODE=hybrid
# hybrid 模式下的 router 分类小模型；留空时 fallback 到 OPENAI_MODEL_NAME。
RAG_ROUTER_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# router 分类最大输出 token。
RAG_ROUTER_MAX_TOKENS=32
# router 分类调用超时秒数。
RAG_ROUTER_TIMEOUT_SECONDS=5

# --- Intent Classifier ---
# intent structured classifier 专用小模型；留空时 fallback 到 OPENAI_MODEL_NAME。
INTENT_CLASSIFIER_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# intent structured classifier 最大输出 token。
INTENT_CLASSIFIER_MAX_TOKENS=256
# intent structured classifier 调用超时秒数。
INTENT_CLASSIFIER_TIMEOUT_SECONDS=5

# --- Embedding（SiliconFlow 同平台或 OpenAI 兼容 embedding 接口）---
# embedding 模型。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# embedding 向量维度，必须和 Qdrant collection 一致。
EMBEDDING_MODEL_DIMS=1024

# --- Rerank ---
# rerank 模型。
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# rerank 候选上限。
RERANK_TOP_K=10

# --- RagSubAgent 二查（主检索空或最高分低于阈值时触发；仅二查，无第三次）---
# 主检索最高分低于该阈值时触发二查。
RAG_SUBAGENT_SCORE_THRESHOLD=0.3
# 二查 top_k；留空时默认 2 × RERANK_TOP_K。
RAG_SUBAGENT_TOP_K=
# 主检索 + 二查合并后的 chunk 上限。
RAG_CHUNKS_MAX=10

# --- KB Ingest（分块约 512–1024 token，overlap 10–15%）---
# ingest 分块目标 token 数。
CHUNK_SIZE_TOKENS=768
# ingest 分块重叠比例。
CHUNK_OVERLAP_RATIO=0.12

# --- Qdrant ---
# Qdrant host。
QDRANT_HOST=localhost
# Qdrant HTTP port。
QDRANT_PORT=6333
# KB collection。
QDRANT_COLLECTION_KB=common_agent_kb
# true 时跳过真实 Qdrant 检索，返回 fixture chunks。
QDRANT_MOCK=false

# --- LangMem inferred memory extraction ---
# langmem inferred 抽取专用小模型；不要留空，否则会回退到主模型。
MEMORY_EXTRACT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# langmem inferred 抽取最大输出 token。
MEMORY_EXTRACT_MAX_TOKENS=128
# langmem inferred 抽取 HTTP 超时秒数。
MEMORY_EXTRACT_TIMEOUT_SECONDS=10

# --- LangGraph Store（用户记忆读路径；与 Checkpointer 同 DATABASE_URL）---
# true 时跳过 Postgres Store 读取，返回空记忆。
MEMORY_STORE_MOCK=false
# 每轮读取 profile + collection facts 的上限。
MEMORY_READ_LIMIT=50
# true 时首次访问 Store 工厂时执行 setup() 迁移。
MEMORY_STORE_SETUP=true

# --- Postgres ---
# LangGraph Checkpointer 数据库 URL。
DATABASE_URL=postgresql://postgres:***@localhost:5432/common_agent

# --- Gateway ---
# Agent Gateway bind host。
AGENT_HOST=0.0.0.0
# Agent Gateway bind port。
AGENT_PORT=18080

# --- Guardrails ---
# false 时跳过入站/出站文本护栏。
GUARDRAILS_ENABLED=true

# --- Context Assembly ---
# 模型上下文中保留最早 K 轮对话。
CONTEXT_PREFIX_TURNS=4
# 模型上下文中保留最近 M 轮对话。
CONTEXT_RECENT_TURNS=20
# rewrite 后保存原始 HumanMessage 文本的 metadata key。
CONTEXT_ORIGINAL_HUMAN_METADATA_KEY=original_human_content
# memory_profile 注入 system prompt 的字段上限。
MEMORY_PROFILE_MAX_FACTS=6
# 未归类用户记忆自由文本 facts 注入 system prompt 的上限。
MEMORY_FREE_TEXT_MAX_FACTS=10
# rolling summary 注入 system prompt 的最大字符数。
SUMMARY_MAX_CHARS=4000
# 单个 RAG chunk 注入 system prompt 的最大字符数。
RAG_CHUNK_MAX_CHARS=1200
# RAG excerpts 整块注入 system prompt 的最大字符数。
RAG_CONTEXT_MAX_CHARS=6000
# 外部 client tool schema 注入 system prompt 的最大字符数。
TOOLS_SCHEMA_MAX_CHARS=3000
# 主模型历史消息最多保留的对话轮数。
MODEL_MESSAGE_MAX_TURNS=24
# 主模型历史消息内容总字符上限。
MODEL_MESSAGE_MAX_CHARS=20000
